# Local development configuration. Copy to .env; never commit populated values.
SPORTS_IQ_SPORT=basketball

# Microsoft Foundry project and deployed model.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-4.1

# Discovered by scripts/fabric_bootstrap.py during azd up.
EVENTHOUSE_URI=https://<eventhouse-query-endpoint>
EVENTHOUSE_DB=SportsIQ_Eventhouse
LAKEHOUSE_SQL_ENDPOINT=<workspace>.datawarehouse.fabric.microsoft.com
LAKEHOUSE_DB=SportsIQ_Lakehouse
LAKEHOUSE_SCHEMA=dbo

# Optional Fabric Data Agent endpoints, configured after publishing the item.
FABRIC_DATA_AGENT_MCP_URL=
FABRIC_DATA_AGENT_OPENAI_URL=
FABRIC_DATA_AGENT_CONNECTION_NAME=

# Optional delivery and observability integrations.
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=
TEAMS_WEBHOOK_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Fictional deterministic demo identifiers.
DEMO_FAN_ID=bas_fan_0001
DEMO_FAN_NAME=Fictional Fan 01-0001
DEMO_GAME_ID=basketball_game_0001
DEMO_SECTION_ID=SEC_B2
DEMO_STADIUM_ID=VENUE_001
DEMO_FAN_EMAIL=

# Local-only checkpoint persistence. Azure uses managed identity.
AZURE_TABLE_STORAGE_ENDPOINT=
CHECKPOINT_TABLE_NAME=WorkflowCheckpoints

# Browser origins allowed to call a locally exposed backend directly.
CORS_ALLOWED_ORIGINS=http://localhost:3000
